                                },
                                "example": [
                                    {
                                        "id": 2,
                                        "nombre": "Sucursal Centro",
                                        "direccion": "Av. Siempre Viva 742",
                                        "telefono": "5559876543",
                                        "email": "centro@agro.com",
                                        "es_matriz": false,
                                        "id_empresa": 1,
